<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>
<p id="notice"></p>
<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
      <h2>Log in</h2>

      <%= form_with url: session_path do |form| %>
        <div class="field">
          <%= form.label :name, class: "mb-2" %><br>
          <%= form.text_field :name, required: true, autofocus: true, autocomplete: "username", value: params[:name], minlength: 2, maxlength: 20, class: "form-control" %>
        </div>

        <div class="field">
          <%= form.label :password, class: "mb-2" %><br>
          <%= form.password_field :password, required: true, autocomplete: "current-password", minlength: 6, class: "form-control" %>
        </div>

        <div class="field">
          <%= form.check_box :remember_me %>
          <%= form.label :remember_me, "Remember me", class: "mb-2" %>
        </div>


        <div class="actions">
          <%= form.submit "Log in", class: "btn btn-primary" %>
        </div>

      <% end %>
      <%= link_to "Sign up", new_user_path %><br>
      <%= link_to "Forgot password?", new_password_path %>
