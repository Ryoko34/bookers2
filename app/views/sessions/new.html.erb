<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<h1>Log in</h1>

<%= form_with url: session_path do |form| %>
  <div class="field">
    <%= form.label :name %><br>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "username", value: params[:name] %>
  </div>

  <div class="field">
    <%= form.label :password %><br>
    <%= form.password_field :password, required: true, autocomplete: "current-password", minimumlength: 6 %>
  </div>

  <div class="actions">
    <%= form.submit "Log in" %>
  </div>

<% end %>
<%= link_to "Sign up", new_user_path %><br>
<%= link_to "Forgot password?", new_password_path %>
