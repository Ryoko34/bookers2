<head>
</head>
<body>
  <header>
  </header>
  <main>
    <p id="notice"></p>

    <div class="container px-5 px-sm-0">
      <div class="row">
        <div class="col-md-3">
          <div class="user-info">
            <h2>User info</h2>
            <%= image_tag @user.get_profile_image(100,100) %>
            <table class="table">
              <tbody>
                <tr></tr>
                <tr>
                  <td>name</td>
                  <td><%= @user.name %></td>
                </tr>
                <tr>
                  <td>introduction</td>
                  <td><%= @user.introduction %></td>
                </tr>
              </tbody>
            <table>
            <div class="row">
              <% if @user == Current.user %>
                <div class="btn btn-outline-secondary btn-block">
                  <%= link_to "Profile Edit", edit_user_path %>
                </div>
              <% end %>
            </div>
          </div>
          <div>
            <h2>New book</h2>
            <%= form_with model: @book do |f| %>
              <div class="field">
                <%= f.label :title %><br>
                <%= f.text_field :title %>
              </div>
              <div class="field">
                <%= f.label :Opinion %><br>
                <%= f.text_area :body, maxlength: 50 %>
              </div>
              <div class="actions">
                <%= f.submit 'Create Book' %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-md-8 offset-md-1">
          <h2>Books</h2>
          <table class="table table-hover table-inverse">
            <thead>
              <tr>
                <th></th>
                <th>Title</th>
                <th>Opinion</th>
                <th colspan="3"></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <%= @books.each do |book| %>
                <td>
                  <%= link_to user_path(book.user_id) %>
                    <%= image_tag book.user.get_profile_image(80,80) %>
                  <% end %>
                </td>
                <td>
                  <%= link_to book_path(book.id) %>
                    <%= book.title %>
                  <% end %>
                </td>
                <td><%= book.body %></td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <footer>
    <div class="container mt-5">
      <div class="row">
        <div class="mx-auto">
          <p>CopyRight Infratop.inc</p>
        </div>
      </div>
    </div>
  </footer>
</body>