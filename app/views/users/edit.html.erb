<p id="notice"></p>
<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h2>User info</h2>

      <% if @user.errors.any? %>
        <div id="error_explanation">
          <h3><%= pluralize(@user.errors.count, "error") %> prohibited this obj from being saved:</h3>
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user do |f| %>
        <div class="form-group mb-3">
          <%= f.label :name, "Name", class: "mb-2" %><br>
          <%= f.text_field :name, autofocus: true, placeholder: "Name", class: "form-control user_name" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :profile_image, "Image", class: "mb-2" %><br>
          <%= f.file_field :profile_image, accept: "image/*" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :introduction,  "Introduction", class: "mb-2" %><br>
          <%= f.text_area :introduction, autofocus: true, class: "form-control user_introduction" %>
        </div>
        <%= f.submit "Update User", class: "btn btn-secondary mb-3" %>
      <% end %>
    </div>
  </div>
</div>