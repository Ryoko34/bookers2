<body>
  <header>
  </header>
  <main>
    <p id="notice"></p>

    <div class="container px-5 px-sm-0">
      <div class="row">
        <div class="col-md-3">
          <div class="user-info">
            <h2>User info</h2>
############## book.user_idのユーザページの表示
          </div>
          <div>
            <h2>New book</h2>
            <%= form_with model: @book do |f| %>
              <div class="field">
                <%= f.label :title %><br>
                <%= f.text_field :title %>
              </div>
              <div class="field">
                <%= f.label :Opinion %><br>
                <%= f.text_area :body, maxlength: 50 %>
              </div>
              <div class="actions">
                <%= f.submit 'Create Book' %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-md-8 offset-md-1">
          <h2>Book detail</h2>
          <table class="table table-hover table-inverse">
            <tbody>
              <tr>
                <td>
                  <%= link_to user_path(book.user_id) %> 
                    <%= image_tag book.user.get_profile_image(80,80) %>
                  <% end %>
                </td>
                <td>
                  <%= lenk_to book_path(book.id) %>
                    <%= book.title %>
                  <% end %>
                </td>
                <td><%= book.body %></td>
                <% if @book.user == Current.user %>
                  <td>
                    <%= link_to "Edit", edit_book_path(@book) %>
                  </td>
                  <td>
                    <%= link_to "Dlete", book_path(@book), data: { turbo_method: :delete } %>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
          <%= link_to "<%= book.user.name %>", book_path(book.user_id) %>
          <% end %>
        </div>
      </div>
    </div>
  </main>
