  <main>
    <p id="notice"></p>

    <div class="container px-5 px-sm-0">
      <div class="row">
        <%= render 'layouts/sidebar', user: @user, book: @book %>
        <div class="col-md-8 offset-md-1">
          <h2>Book detail</h2>
          <table class="table table-hover table-inverse">
            <tbody>
              <tr>
                <%= link_to user_path(@book.user_id) do %>
                  <td>
                    <%= image_tag @book.user.get_profile_image(80,80) %>
                  </td>
                  <td>
                    <%= link_to @book.title, book_path(@book.id) %>
                  </td>
                  <td><%= @book.body %></td>
                <% end %>
                <% if @book.user == Current.user %>
                  <td>
                    <%= link_to "Edit", edit_book_path(@book), class: "btn btn-success btn-sm" %>
                  </td>
                  <td>
                    <%= link_to "Delete", book_path(@book), data: { turbo_method: :delete }, class: "btn btn-danger btn-sm" %>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
          <%= link_to @book.user.name, user_path(@book.user_id) %>
        </div>
      </div>
    </div>
  </main>
