<p id="notice"></p>
<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h1>Editing Book</h1>
      <%= form_with model: @book do |f| %>
        <div class="form-group mb-3">
          <%= f.label :title, "Title", class: "mb-2" %><br>
          <%= f.text_field :title, autofocus: true, class: "form-control book_title" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :bidy, "Opinion", class: "mb-2" %><br>
          <%= f.text_area :body, autofocus: true, class: "form-control book_body" %>
        </div>
        <div class="form-group mb-3">
          <%= f.submit "Update Book", class: "btn btn-success" %>
        </div>
      <% end %>
      <%= link_to 'Show', book_path(@book) %>
        | 
      <%= link_to 'Back', '/books' %>
    </div>
  </div>
</div>