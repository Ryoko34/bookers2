<head>
</head>
<body>
  <h2>Editing Book</h2.
  <%= form_with model: @book do |f| %>
    <div class="field">
      <%= f.label :Title %><br>
      <%= f.text_field :name, autofocus: true, id: "inputName" %>
    </div>
    <div class="field">
      <%= f.label :Opinion %><br>
      <%= f.text_area :body, autofocus: true, id: "inputOpinion" %>
    </div>
    <div class="actions">
      <%= f.submit "Update Book" %>
    </div>
  <% end %>
  <nav>
    <%= link_to 'Show', book_path(@book) %>
     | 
    <%= link_to 'Back', '/books' %>
  </nav>
</body>
<footer>
</footer>
